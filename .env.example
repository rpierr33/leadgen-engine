# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Redis (Upstash or local)
REDIS_URL="redis://localhost:6379"

# Search API (pick one)
SERPER_API_KEY=""
BRAVE_SEARCH_API_KEY=""

# AI Extraction (pick one)
OPENAI_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"
LLM_PROVIDER="openai" # "openai" | "ollama"
LLM_MODEL="gpt-4o-mini" # or "mistral" / "llama3" for Ollama

# Email Enrichment (optional paid fallbacks)
HUNTER_API_KEY=""
DROPCONTACT_API_KEY=""
CLEARBIT_API_KEY=""

# Scraping
RESPECT_ROBOTS_TXT="true"
SCRAPE_MIN_DELAY_MS="1000"
SCRAPE_MAX_DELAY_MS="3000"
PROXY_URL="" # optional rotating proxy

# Optional paid scraping fallbacks
SCRAPFLY_API_KEY=""
ZYTE_API_KEY=""

# Feature flags
ENABLE_LINKEDIN_SCRAPING="false"
ENABLE_LEAD_SCORING="false"
ENABLE_DEDUPLICATION="true"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
